# ============================================
# 元点Saas Docker 部署环境变量
# 复制此文件为 .env 后使用: docker-compose up -d
# ============================================

# Nginx 对外端口
NGINX_PORT=80

# MySQL 配置
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=ydadmin123
MYSQL_DATABASE=yd_admin
MYSQL_USER=ydadmin
MYSQL_PASSWORD=ydadmin123

# Redis 配置
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# SaaS 多租户配置
# ============================================

# SaaS 主域名 —— 用于 nginx 多 vhost 路由
#   admin.$SAAS_ROOT_DOMAIN  → 平台超管
#   *.$SAAS_ROOT_DOMAIN      → 租户（通配子域名）
#   $SAAS_ROOT_DOMAIN        → 公共前台
# 本地开发可用 localhost.local 配合 /etc/hosts 映射
SAAS_ROOT_DOMAIN=example.com
