# ============================================================
# YdSaas 环境配置示例
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

APP_DEBUG = false
APP_TRACE = false
# 生产环境请生成32+字符的随机字符串
APP_KEY = change-me-app-key
# 日志通道: file=文件（开发）, stdout=JSON标准输出（Docker/生产）
LOG_CHANNEL = file

# ============================================================
# JWT 双密钥（platform 和 tenant 物理隔离，防止跨 scope 用 token）
# 生产环境必须生成至少 32 字节的随机字符串
# ============================================================
JWT_TENANT_SECRET = change-me-tenant-secret-must-be-32-bytes-or-longer
JWT_PLATFORM_SECRET = change-me-platform-secret-must-be-32-bytes-or-longer
JWT_TENANT_ISSUER = ydsaas-saas-tenant
JWT_PLATFORM_ISSUER = ydsaas-saas-platform
JWT_EXPIRE = 7200
JWT_REFRESH_EXPIRE = 86400

# ============================================================
# 移动端构建 driver（顶层变量，代码直接读取 MOBILE_BUILD_DRIVER 环境变量）
#   local  = 默认，本机 pnpm/uni build
#   docker = 容器构建（Phase 2 接入）
#   remote = 远程构建服务（Phase 3 接入）
# docker / remote 的专属变量在对应 Phase 补充。
# ============================================================
MOBILE_BUILD_DRIVER = local
MOBILE_BUILD_TIMEOUT_SEC = 900
# docker driver 专属（MOBILE_BUILD_DRIVER=docker 时生效）
MOBILE_BUILD_DOCKER_IMAGE = ydsaas/uniapp-builder:latest
MOBILE_BUILD_DOCKER_MEMORY = 2g
MOBILE_BUILD_DOCKER_CPUS = 2
MOBILE_BUILD_DOCKER_NETWORK =
# remote driver 专属（MOBILE_BUILD_DRIVER=remote 时生效）
MOBILE_BUILD_REMOTE_URL = https://build.example.com
# token 含 # ! % 等特殊字符时必须加双引号，否则 parse_ini_file 会把 # 后当成注释截断
MOBILE_BUILD_REMOTE_TOKEN = "change-me"
MOBILE_BUILD_REMOTE_TIMEOUT_SEC = 1800
MOBILE_BUILD_REMOTE_POLL_INTERVAL_SEC = 5

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DB]
TYPE = mysql
HOST = 127.0.0.1
PORT = 3306
NAME = dev007
USER = root
PASS = root
CHARSET = utf8mb4
# PREFIX =

[CACHE]
# 可选值：
#   tenant_redis = 租户感知 Redis（推荐 / 生产必用）——自动给 key 加租户前缀，
#                  保证多租户缓存隔离，且标签缓存走 Redis Set，稳定可靠。
#   redis        = 原生 Redis，无租户前缀。
#   file         = 文件缓存，仅限单租户开发环境。
# ⚠️ 多租户生产环境务必用 tenant_redis：file/redis 无租户前缀，不同租户中
#    admin_id 相同的管理员会共用权限缓存（跨租户串号，安全隐患）；且 file 驱动的
#    标签缓存一旦标签键损坏会抛 "only array cache can be push" 导致后台 500。
# 需要先安装 Redis 服务与 phpredis 扩展，并配置下方 [REDIS] 段。
DRIVER = tenant_redis
EXPIRE = 3600
PREFIX = think

[SESSION]
TYPE = file
EXPIRE = 1800
PREFIX = think

[REDIS]
# Docker 环境使用 HOST = redis，即容器服务名
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0
TIMEOUT = 0
EXPIRE = 3600
PERSISTENT = false
PREFIX = think

[QUEUE]
# sync=同步执行（开发环境）, redis=异步队列（生产环境推荐）
CONNECTOR = redis

# ============================================================
# SaaS 配置
# 重要：本段必须放在 SAAS 分节下，且键名不带 SAAS_ 前缀。
# ThinkPHP 用 parse_ini_file 分节加载，会自动给键名补 SAAS_ 前缀，
# 因此这里写 PLATFORM_DOMAIN，代码里读 SAAS_PLATFORM_DOMAIN 才取得到值。
# 切勿把这些键放到别的分节例如 QUEUE 下，否则会变成 QUEUE_SAAS_ 开头而读不到。
# ============================================================
[SAAS]
# tenantapi 子域名解析用的根域名，例如 example.com
ROOT_DOMAIN = app.com
# 平台超管后台访问域名，必须与实际访问后台的 Host 完全一致，否则平台接口返回 404 租户上下文未识别
PLATFORM_DOMAIN = admin.app.com
GRACE_DAYS = 7
# 本地开发兜底：Host 无子域名时使用的 tenant_code，仅 APP_DEBUG=true 生效
DEV_TENANT_CODE =
# CORS 额外允许的 Origin，逗号分隔
CORS_ALLOWED_ORIGINS =

# 官方市场客户端密钥，AES-256-GCM，64 位 hex，用 openssl rand -hex 32 生成
# 必填且一经设置不可更改：用于加密存储的实例 token，改了会导致已存 token 无法解密。
MARKETPLACE_ENCRYPTION_KEY =
# 开放 API 基址，服务器到服务器调用
MARKETPLACE_DEFAULT_SITE = https://www.dev007.cn
# 浏览器前端站点基址，留空 = 同 MARKETPLACE_DEFAULT_SITE，即生产前端与开放 API 同根
MARKETPLACE_WEB_BASE =

# SaaS 级支付、平台自己的商户号、和租户的 system_configs 解耦
PAY_NOTIFY_BASE_URL =

PAY_WECHAT_ENABLED = false
PAY_WECHAT_APP_ID =
PAY_WECHAT_MCH_ID =
PAY_WECHAT_API_V3_KEY =
PAY_WECHAT_SERIAL_NO =
PAY_WECHAT_PRIVATE_KEY_PATH =
PAY_WECHAT_CERT_PATH =

PAY_ALIPAY_ENABLED = false
PAY_ALIPAY_APP_ID =
PAY_ALIPAY_PRIVATE_KEY =
PAY_ALIPAY_PUBLIC_KEY =

# ============================================================
# 邮件配置（平台级，用于到期提醒等系统通知）
# ============================================================
[MAIL]
DRIVER = smtp
HOST =
PORT = 465
USERNAME =
PASSWORD =
ENCRYPTION = ssl
FROM_ADDRESS = noreply@example.com
FROM_NAME = YdSaas
